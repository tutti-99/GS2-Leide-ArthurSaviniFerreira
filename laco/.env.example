# Copie este arquivo para ".env" e troque os valores.  NUNCA envie o .env para o GitHub.
# Para gerar chaves/segredos aleatórios:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- MySQL (usuário da APLICAÇÃO, criado pelo setup_db.py com privilégio mínimo)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=laco
DB_USER=laco_app
DB_PASSWORD=troque-por-uma-senha-forte

# --- Chave da central de voluntários (header X-API-Key). Mínimo 16 caracteres.
API_KEY_CENTRAL=troque-por-uma-chave-aleatoria

# --- Socket TCP da central de alertas
CENTRAL_HOST=127.0.0.1
CENTRAL_PORT=5050
# Segredo do HMAC que assina as mensagens TCP. Mínimo 16 caracteres.
SOCKET_SECRET=troque-por-outro-segredo-aleatorio

# --- Alertas climáticos (Open-Meteo)
LIMIAR_CALOR=32
LIMIAR_UMIDADE=30

# --- Outros
FLASK_DEBUG=0
LOG_ARQUIVO=logs/laco.log
LOG_CENTRAL=logs/central.log
